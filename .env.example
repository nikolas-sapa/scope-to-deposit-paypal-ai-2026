# Local application configuration. Never commit .env.local.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=.data/scope.sqlite

# Existing sandbox Business REST app, never a live app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Server-only. Verify provider access, rates and quota before enabling.
# Allowed models: deepseek-v4-flash or glm-5.3-flash. No automatic fallback.
VYCEAI_API_KEY=
VYCEAI_MODEL=deepseek-v4-flash
AI_USAGE_ENABLED=false
