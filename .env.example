# Local application configuration. Never commit .env.local.
APP_ORIGIN=http://127.0.0.1:3000
DATABASE_PATH=.data/scope.sqlite

# Existing sandbox Business REST app, never a live app.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=

# Server-only. Generate only after authorized usage/budget.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_USAGE_ENABLED=false
